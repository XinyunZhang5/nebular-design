# Copy to .env and fill in. In production none of this lives in a file —
# `fly secrets set` injects it as environment variables at boot.

# "development" or "production". In production the app refuses to start with a
# placeholder SECRET_KEY or a plaintext http:// frontend origin — see
# config.py's check_production().
ENV=development

# Database (PostgreSQL).
# A hosted URL can be pasted in exactly as the provider gives it, including
# ?sslmode=require&channel_binding=require — those are libpq spellings that
# asyncpg rejects, and config.py translates them.
DATABASE_URL=postgresql+asyncpg://nebular:nebular@localhost:5432/nebulardb

# JWT. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Anthropic. Claude names and describes the build; it never touches the geometry.
ANTHROPIC_API_KEY=sk-ant-...

# Object storage — Cloudflare R2 or AWS S3. Same API, so the same settings.
USE_S3=false                    # false: save under ./uploads and serve at /static/
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=nebular-uploads

# R2: https://<account-id>.r2.cloudflarestorage.com — the bucket name is NOT part
# of it. Leave empty for real AWS S3, and set AWS_REGION instead.
S3_ENDPOINT_URL=
AWS_REGION=us-east-1

# Depth estimation (DepthAnything V2)
ENABLE_DEPTH_ESTIMATION=true
DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf

# Segmentation (SegFormer / ADE20K)
SEGMENTATION_MODEL=nvidia/segformer-b0-finetuned-ade-512-512

# CORS. Comma-separated. localhost is always allowed on top of whatever is here.
FRONTEND_URL=http://localhost:3000
